<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <header class="bg-umass text-white p-5">
      <h1 class="text-2xl font-bold"><%= title %></h1>
    </header>
    <main class="p-5">
      <form
        id="item-form"
        class="flex flex-col gap-3 mb-6 sm:flex-row sm:flex-wrap sm:items-end"
      >
        <input
          type="text"
          name="name"
          placeholder="Name"
          class="p-1.5 border border-gray-300 rounded"
        />
        <select
          name="diningHallId"
          class="p-1.5 border border-gray-300 rounded"
        ></select>
        <input
          type="text"
          name="section"
          placeholder="Section"
          class="p-1.5 border border-gray-300 rounded"
        />
        <button
          class="px-2.5 py-1.5 border border-green-700 text-green-700 bg-white hover:bg-green-50 rounded cursor-pointer"
          type="submit"
        >
          Add item
        </button>
      </form>
      <ul id="items" class="item-list flex flex-col gap-2 mb-6"></ul>
      <a
        href="/"
        class="block w-full text-center mb-2 bg-umass text-white px-3 py-1.5 rounded hover:bg-umass-dark sm:inline-block sm:w-auto sm:mb-0 sm:mr-2.5"
        >Back</a
      >
    </main>
    <script src="/app.js" defer></script>
  </body>
</html>
